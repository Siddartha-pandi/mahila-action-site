# Next.js application and API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend & Database Configuration (PostgreSQL)
PORT=3000
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_SSL=true

# Security & Administrator Authentication
JWT_SECRET=your_jwt_secret_here
AUTH_SECRET=your_authjs_secret_or_jwt_secret
SUPERADMIN_EMAIL=your_superadmin_email_here
SUPERADMIN_PASSWORD=your_superadmin_password_here
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Optional Auth.js Google Sign-In (for one-click admin sign in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Drive API v3 & OAuth 2.0 (Personal Gmail Account)
# Generate from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Run `npm run setup:drive` or authorize via /api/admin/google-drive/auth to generate your refresh token
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
# Optional: ID of a dedicated folder in your Google Drive (leave empty to auto-create "MahilaActionMedia")
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_EMAIL=your_drive_email@gmail.com

# Email / SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Mahila Action <your_email@gmail.com>"
