# Next.js application and API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend & Database Configuration (PostgreSQL)
PORT=3000
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_SSL=true

# Security & Administrator Authentication
JWT_SECRET=your_jwt_secret_here
AUTH_SECRET=your_authjs_secret_or_jwt_secret
SUPERADMIN_EMAIL=your_superadmin_email_here
SUPERADMIN_PASSWORD=your_superadmin_password_here
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Optional Auth.js Google Sign-In (for one-click admin sign in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email / SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Mahila Action <your_email@gmail.com>"

# UPI Payment Details
NEXT_PUBLIC_UPI_ID=your_upi_id@bank
NEXT_PUBLIC_UPI_VPA=your_upi_id@bank
NEXT_PUBLIC_UPI_PAYEE_NAME="Mahila Action"

# ─────────────────────────────────────────────────────────────────────────────
# Neon Object Storage (S3-compatible)
# ─────────────────────────────────────────────────────────────────────────────
# Get these values from your Neon Console → Object Storage → Bucket → Access Keys
# NEVER expose these to the browser or commit them to version control.

# Your Neon Object Storage endpoint (e.g. https://ep-xxx.neon.tech or S3-compatible URL)
NEON_S3_ENDPOINT=https://your-neon-object-storage-endpoint

# AWS region (use us-east-1 for Neon Object Storage unless specified otherwise)
NEON_S3_REGION=us-east-1

# Neon Object Storage access credentials (server-side only, never NEXT_PUBLIC_)
NEON_S3_ACCESS_KEY_ID=your_neon_access_key_id
NEON_S3_SECRET_ACCESS_KEY=your_neon_secret_access_key

# Bucket names (must be pre-created in the Neon console)
NEON_PUBLIC_BUCKET=ngo-public-media
NEON_PRIVATE_BUCKET=ngo-private-media

# Optional: Maximum image upload size in megabytes (default: 20 MB)
STORAGE_MAX_IMAGE_SIZE_MB=20

# Optional: Presigned URL expiry in seconds for private images (default: 3600 = 1 hour)
STORAGE_PRESIGN_EXPIRY_SECONDS=3600

